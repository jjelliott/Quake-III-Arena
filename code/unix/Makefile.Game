	$(CGDIR)/vm/q_shared.asm

$(BDIR)/$(GAMEDIR)/vm/cgame.qvm : $(CGVMASM)
	$(Q3ASM) -o $@ $(CGVMASM) $(CGDIR)/cg_syscalls.asm

$(CGDIR)/vm/cg_main.asm : $(CGDIR)/cg_main.c; $(DO_LCC)
$(CGDIR)/vm/cg_consolecmds.asm : $(CGDIR)/cg_consolecmds.c; $(DO_LCC)
