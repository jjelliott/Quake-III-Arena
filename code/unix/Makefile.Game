$(CGDIR)/vm/cg_event.asm : $(CGDIR)/cg_event.c; $(DO_LCC)
$(CGDIR)/vm/cg_info.asm : $(CGDIR)/cg_info.c; $(DO_LCC)
$(CGDIR)/vm/cg_localents.asm : $(CGDIR)/cg_localents.c; $(DO_LCC)
$(CGDIR)/vm/cg_marks.asm : $(CGDIR)/cg_marks.c; $(DO_LCC)
$(CGDIR)/vm/cg_players.asm : $(CGDIR)/cg_players.c; $(DO_LCC)
$(CGDIR)/vm/cg_playerstate.asm : $(CGDIR)/cg_playerstate.c; $(DO_LCC)
$(CGDIR)/vm/cg_predict.asm : $(CGDIR)/cg_predict.c; $(DO_LCC)
$(CGDIR)/vm/cg_scoreboard.asm : $(CGDIR)/cg_scoreboard.c; $(DO_LCC)
$(CGDIR)/vm/cg_servercmds.asm : $(CGDIR)/cg_servercmds.c; $(DO_LCC)
$(CGDIR)/vm/cg_snapshot.asm : $(CGDIR)/cg_snapshot.c; $(DO_LCC)
$(CGDIR)/vm/cg_view.asm : $(CGDIR)/cg_view.c; $(DO_LCC)
$(CGDIR)/vm/cg_weapons.asm : $(CGDIR)/cg_weapons.c; $(DO_LCC)
$(CGDIR)/vm/bg_slidemove.asm : $(GDIR)/bg_slidemove.c; $(DO_LCC)
$(CGDIR)/vm/bg_pmove.asm : $(GDIR)/bg_pmove.c; $(DO_LCC)
$(CGDIR)/vm/bg_lib.asm : $(GDIR)/bg_lib.c; $(DO_LCC)
$(CGDIR)/vm/bg_misc.asm : $(GDIR)/bg_misc.c; $(DO_LCC)
$(CGDIR)/vm/q_math.asm : $(GDIR)/q_math.c; $(DO_LCC)
$(CGDIR)/vm/q_shared.asm : $(GDIR)/q_shared.c; $(DO_LCC)

#############################################################################
# UI VM  (base q3_ui)
